# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
/tmp/wa-engineer.log

# Dependency directories
node_modules/

# Environment variables
.env
.env.production
.env.local

# Agent local-only files (env hints, infra notes, current-sprint marker).
# These contain deploy-time secrets and infra details that must NEVER
# be committed. Read by the prod-deployment master agent's workers.
agents/**/env.local.json
agents/**/infra.local.md
agents/**/current_sprint.txt
# ...including editor/manual backups of them — `env.local.json.bak` is NOT matched
# by the rule above and holds live PROD secrets (JWT_SECRET, LiteLLM key, PostHog key).
agents/**/env.local.json.*
*.bak

# Google service-account credentials (never commit secrets)
google-sa.json
*service-account*.json
*service_account*.json
service_account_live.json
*-sa.json
*.credentials.json
gcp-*.json

# Databases and App State
*.db
*.sqlite
*.sqlite3
sessions.db
sessions.db-journal
sessions.local.db-shm
sessions.local.db-wal
agents/*/state.json
auth_info/

# Runtime user uploads (not source)
uploads/

# Downloaded Knowledge Base
kb/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# OS metadata
.DS_Store
Thumbs.db
sessions.db-shm
sessions.db-wal
cron_jobs.json
